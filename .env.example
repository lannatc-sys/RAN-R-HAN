# ==============================================================================
# Rab-R-HAN (รับอาหาร) Environment Configuration Template
# File: .env.example
# ==============================================================================

# 1. Supabase Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Shop Payment Credentials Encryption (AES-256-GCM, 32 bytes hex)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Web Push Notification (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@rab-r-han.local

# 4. SlipOK Webhook Secret
SLIPOK_WEBHOOK_SECRET=your-slipok-webhook-secret

# 4b. Cron Job Secret (for /api/cron/data-retention) — generate a dedicated random value, do NOT reuse SUPABASE_SERVICE_ROLE_KEY
CRON_SECRET=your-dedicated-cron-secret

# 5. Super Admin Configuration (comma-separated emails)
SUPER_ADMIN_USER=admin@example.com

# 6. Telegram Bot Notification (Customer Status Updates)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
# Secret sent as secret_token when registering the webhook and compared
# against the x-telegram-bot-api-secret-token header on every update.
# Generate a dedicated random value (e.g. 32+ bytes hex). The webhook route
# refuses all requests while this is unset.
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
# Full https URL of /api/telegram/webhook used only by scripts/setup-telegram-bot.js
# when (re)registering. Leave empty to skip registration and only verify.
# Never point this at production without approval.
TELEGRAM_WEBHOOK_URL=
# Chat ID ของผู้ดูแลแพลตฟอร์ม สำหรับรับแจ้งเตือนคำขออนุมัติ
# ไม่ตั้งค่าก็ได้ ระบบจะข้ามการแจ้งเตือนแต่คำขอยังเข้าคิวตามปกติ
TELEGRAM_SUPERADMIN_CHAT_ID=

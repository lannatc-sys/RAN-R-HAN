# ==============================================================================
# Rab-R-HAN (รับอาหาร) Environment Configuration Template
# File: .env.example
# ==============================================================================

# 1. Supabase Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Shop Payment Credentials Encryption (AES-256-GCM, 32 bytes hex)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Web Push Notification (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@rab-r-han.local

# 4. SlipOK Webhook Secret
SLIPOK_WEBHOOK_SECRET=your-slipok-webhook-secret

# 4b. Cron Job Secret (for /api/cron/data-retention) — generate a dedicated random value, do NOT reuse SUPABASE_SERVICE_ROLE_KEY
CRON_SECRET=your-dedicated-cron-secret

# 5. Super Admin Configuration (comma-separated emails)
SUPER_ADMIN_USER=admin@example.com

# 6. Telegram Bot Notification (Customer Status Updates)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
